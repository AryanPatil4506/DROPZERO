# Copy to .env and fill in. Never commit .env.

# 32-byte AES key, base64. Generate with: python scripts/gen_key.py
DROPZERO_MEDIA_KEY=

# Where the DB, encrypted media, caches and per-job work dirs live (gitignored).
DROPZERO_DATA_DIR=var

# Encrypted uploads older than this are purged at startup.
DROPZERO_MEDIA_RETENTION_HOURS=72

# Optional explicit ffmpeg/ffprobe paths (otherwise PATH and the winget install dir are searched).
DROPZERO_FFMPEG=
DROPZERO_FFPROBE=

# auto | cuda | cpu
DROPZERO_ASR_DEVICE=auto
DROPZERO_EMBED_DEVICE=auto

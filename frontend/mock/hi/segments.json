  "index": 5,
  "kind": "speech",
  "start": 55.805,
  "end": 66.85,
  "speech_start": 56.205,
  "speech_end": 66.45,
  "text": "एक लीटर दूध में दो चम्मच जामन डालिए। जामन मतलब पिछले दिन का थोड़ा सा दही। इसे अच्छी तरह मिला दीजिए।",
  "sentence_ids": [

 ],
 "sentences": [
  {
   "idx": 0,
   "start": 0.0,
   "end": 2.727,
   "text": "घर पर गाढ़ा दही कैसे जमाएं",
   "word_start": 0,
   "word_end": 6,
   "end_reason": "pause"
  },
  {
   "idx": 1,
   "start": 3.527,
   "end": 6.709,
   "text": "नमस्ते दोस्तों, चैनल पर आपका स्वागत है।",
   "word_start": 6,
   "word_end": 13,
   "end_reason": "punct"
  },
  {
   "idx": 2,
   "start": 7.059,
   "end": 11.15,
   "text": "तो आज हम बात करेंगे दही के बारे में।",
   "word_start": 13,
   "word_end": 22,
   "end_reason": "punct"
  },
  {
   "idx": 3,
   "start": 11.5,
   "end": 16.955,
   "text": "मतलब, बहुत लोग पूछते हैं कि उनका दही पतला क्यों जमता है।",
   "word_start": 22,
   "word_end": 34,
   "end_reason": "punct"
  },
  {
   "idx": 4,
   "start": 17.755,
   "end": 26.845,
   "text": "इस वीडियो के आखिर में मैं आपको दिखाऊंगी कि सिर्फ आठ घंटे में बाज़ार जैसा गाढ़ा दही कैसे जमता है।",
   "word_start": 34,
   "word_end": 54,
   "end_reason": "punct"
  },
  {
   "idx": 5,
   "start": 27.645,
   "end": 31.282,
   "text": "सबसे पहले दूध को अच्छी तरह उबाल लीजिए।",
   "word_start": 54,
   "word_end": 62,
   "end_reason": "punct"
  },
  {
   "idx": 6,
   "start": 31.632,
   "end": 38.905,
   "text": "उबालने से दूध के बैक्टीरिया मर जाते हैं और दूध थोड़ा गाढ़ा भी हो जाता है।",
   "word_start": 62,
   "word_end": 78,
   "end_reason": "punct"
  },
  {
   "idx": 7,
   "start": 39.705,
   "end": 42.432,
   "text": "अब दूध को ठंडा होने दीजिए।",
   "word_start": 78,
   "word_end": 84,
   "end_reason": "punct"
  },
  {
   "idx": 8,
   "start": 42.782,
   "end": 50.055,
   "text": "दूध इतना गुनगुना होना चाहिए कि आपकी उंगली दस सेकंड तक उसमें आराम से रह सके।",
   "word_start": 84,
   "word_end": 100,
   "end_reason": "punct"
  },
  {
   "idx": 9,
   "start": 50.405,
   "end": 55.405,
   "text": "अगर दूध बहुत गरम होगा तो जामन के बैक्टीरिया मर जाएंगे।",
   "word_start": 100,
   "word_end": 111,
   "end_reason": "punct"
  },
  {
   "idx": 10,
   "start": 56.205,
   "end": 59.841,
   "text": "एक लीटर दूध में दो चम्मच जामन डालिए।",
   "word_start": 111,
   "word_end": 119,
   "end_reason": "punct"
  },
  {
   "idx": 11,
   "start": 60.191,
   "end": 63.827,
   "text": "जामन मतलब पिछले दिन का थोड़ा सा दही।",
   "word_start": 119,
   "word_end": 127,
   "end_reason": "punct"
  },
  {
   "idx": 12,
   "start": 64.177,
   "end": 66.45,
   "text": "इसे अच्छी तरह मिला दीजिए।",
   "word_start": 127,
   "word_end": 132,
   "end_reason": "punct"
  },
  {
   "idx": 13,
   "start": 67.25,
   "end": 70.432,
   "text": "अच्छा, एक बात फिर से समझ लीजिए।",
   "word_start": 132,
   "word_end": 139,
   "end_reason": "punct"
  },
  {
   "idx": 14,
   "start": 70.782,
   "end": 80.327,
   "text": "दूध को पहले उबालना ज़रूरी है, क्योंकि उबालने से उसके बैक्टीरिया खत्म हो जाते हैं और दूध गाढ़ा हो जाता है।",
   "word_start": 139,
   "word_end": 160,
   "end_reason": "punct"
  },
  {
   "idx": 15,
   "start": 81.127,
   "end": 85.673,
   "text": "अब बर्तन को ढककर किसी गरम जगह पर रख दीजिए।",
   "word_start": 160,
   "word_end": 170,
   "end_reason": "punct"
  },
  {
   "idx": 16,
   "start": 86.023,
   "end": 92.386,
   "text": "सर्दियों में आप इसे कैसरोल में या आटे के डिब्बे में रख सकते हैं।",
   "word_start": 170,
   "word_end": 184,
   "end_reason": "punct"
  },
  {
   "idx": 17,
   "start": 93.186,
   "end": 95.914,
   "text": "दही कितनी देर में जमता है?",
   "word_start": 184,
   "word_end": 190,
   "end_reason": "punct"
  },
  {
   "idx": 18,
   "start": 96.264,
   "end": 102.627,
   "text": "गर्मियों में लगभग छह घंटे और सर्दियों में आठ से दस घंटे लगते हैं।",
   "word_start": 190,
   "word_end": 204,
   "end_reason": "punct"
  },
  {
   "idx": 19,
   "start": 103.427,
   "end": 107.973,
   "text": "जमने के बाद दही को तुरंत फ्रिज में रख दीजिए।",
   "word_start": 204,
   "word_end": 214,
   "end_reason": "punct"
  },
  {
   "idx": 20,
   "start": 108.323,
   "end": 111.05,
   "text": "इससे दही ज़्यादा खट्टा नहीं होगा।",
   "word_start": 214,
   "word_end": 220,
   "end_reason": "punct"
  },
  {
   "idx": 21,
   "start": 111.85,
   "end": 114.577,
   "text": "तो ये रहा हमारा गाढ़ा दही।",
   "word_start": 220,
   "word_end": 226,
   "end_reason": "punct"
  },
  {
   "idx": 22,
   "start": 114.927,
   "end": 119.018,
   "text": "चम्मच उल्टा करने पर भी ये गिरता नहीं है।",
   "word_start": 226,
   "word_end": 235,
   "end_reason": "punct"
  },
  {
   "idx": 23,
   "start": 119.368,
   "end": 125.732,
   "text": "वीडियो पसंद आए तो लाइक कीजिए और बताइए कि अगली रेसिपी कौन सी हो।",
   "word_start": 235,
